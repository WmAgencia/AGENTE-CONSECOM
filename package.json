{
  "name": "agente-consecom",
  "version": "0.1.0",
  "description": "Agente de prospecção de marketing (Consecom) powered by NVIDIA API",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/test/chat.integration.test.ts src/test/tools.unit.test.ts src/test/phone.unit.test.ts",
    "clean": "rimraf dist",
    "db:apply": "node apply_sql.cjs supabase-CONSOLIDADO.sql",
    "db:check": "node verify_migrations.cjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "^9.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^4.28.1",
    "pg": "^8.22.0",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/pg": "^8.20.4",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2"
  }
}
