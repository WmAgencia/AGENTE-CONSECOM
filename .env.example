# Port exposed by Railway (optional locally; defaults to 3000)
PORT=3000

# Public base URL of this backend. Used to register the Evolution API
# webhook (POST {PUBLIC_BASE_URL}/webhook/evolution). On Railway, set
# to your Railway domain (Railway also injects RAILWAY_PUBLIC_DOMAIN
# automatically, which takes precedence if both are set).
# Local dev example: http://localhost:3000
PUBLIC_BASE_URL=

# NVIDIA API key - NEVER commit a real value
NVIDIA_API_KEY=

# Service metadata (safe to expose)
SERVICE_NAME=agente-consecom
SERVICE_VERSION=0.1.0

# Log level: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# Agent behavior knobs
AGENT_MODEL=meta/llama-3.1-8b-instruct
AGENT_MAX_TOKENS=1024

# === Evolution API integration (webhook MVP) ===

# Base URL of your Evolution API instance, including https://
# Use the literal "mock://evolution" to run locally WITHOUT calling a real
# Evolution API.
EVOLUTION_API_URL=

# API key used in the `apikey` header to call Evolution API endpoints.
EVOLUTION_API_KEY=

# Name of the WhatsApp instance configured in your Evolution API.
EVOLUTION_INSTANCE_NAME=

# Shared secret required on every incoming webhook call.
WEBHOOK_SECRET=

# Comma-separated list of Evolution events accepted by the webhook.
EVOLUTION_WEBHOOK_EVENTS=messages.upsert,messages.upsert-ephemeral

# How many parallel NVIDIA calls the webhook handler is allowed to make.
EVOLUTION_AGENT_CONCURRENCY=1

# === Agent loop + tools ===

# Master switch for tool use. For prospeção (marcar_reuniao + notify) enable:
AGENT_ENABLE_TOOLS=true

# Comma-separated permissions allowed at runtime.
# Categories: READ, WRITE, EXECUTE, NETWORK, WHATSAPP
AGENT_ALLOWED_PERMS=READ,NETWORK,WHATSAPP

# Optional comma-separated allowlist of tool names. If empty, all whitelisted.
AGENT_ALLOWED_TOOLS=

# Filesystem root for READ/WRITE tools. Defaults to ./workspace
AGENT_ALLOWED_DIR=

# Max agent loop iterations per request (1..20).
AGENT_MAX_ITERATIONS=6

# Per-tool execution timeout in ms.
AGENT_TOOL_TIMEOUT_MS=15000

# "auto" (default) to detect tool support on first request.
AGENT_MODEL_SUPPORTS_TOOLS=auto

# === Persistence ===

# Postgres connection string (conversations persistence). When unset, falls
# back to in-RAM storage. You can use Supabase's Postgres connection string or
# Neon/Railway Postgres.
DATABASE_URL=

# === Consecom prospeção (Supabase) ===

# Base URL of your Supabase project, e.g. https://<ref>.supabase.co
SUPABASE_URL=

# Supabase service role key OR a key with permission to run consecom_marcar_reuniao.
SUPABASE_SERVICE_ROLE_KEY=

# RPC function name that records a won meeting for a lead id.
SUPABASE_MARCAR_REUNIAO_RPC=consecom_marcar_reuniao

# WhatsApp group JID notified on won meetings (requires Evolution API).
AGENT_ADMIN_GROUP_JID=

# === Public API ===

# Bearer token for POST /api/chat ("Authorization: Bearer <AGENT_API_KEY>").
# Generate with:  openssl rand -hex 32
AGENT_API_KEY=

# Comma-separated CORS origin allowlist. Use the literal "*" ONLY for local dev.
ALLOWED_ORIGINS=

# === Extensão Vyntra Prospector (download) ===

# Bucket do Supabase Storage que armazena o build público da extensão.
# Default: consecom-media (público para SELECT).
EXTENSION_BUCKET=consecom-media

# Caminho do objeto (.zip) dentro do bucket.
EXTENSION_OBJECT_PATH=extensions/vyntra-prospector.zip